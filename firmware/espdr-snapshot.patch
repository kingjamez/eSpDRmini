diff --git a/esp32s3/src/capture.c b/esp32s3/src/capture.c
index 209e8ae..e0d2986 100644
--- a/esp32s3/src/capture.c
+++ b/esp32s3/src/capture.c
@@ -502,3 +502,49 @@ uint32_t capture_stat(unsigned index)
     default: return 0;
     }
 }
+
+/*
+ * Single-bank snapshot for hosts without the FPGA link. The writer fills
+ * bank 0 from ring index 0 and is stopped before it wraps, so pairs
+ * [SNAPSHOT_FIRST, SNAPSHOT_FIRST + SNAPSHOT_PAIRS) are one contiguous block.
+ * Core 1 stays idle and the link outputs are not used. Returns the block, or
+ * 0 if the writer missed its schedule or did not fill it.
+ */
+const uint32_t *capture_snapshot(void)
+{
+    const unsigned stop_at = LINK_RING_PAIRS - 512u;
+    unsigned pairs_per_tick = radio_pairs_per_tick();
+    uint32_t control = radio_dump_control();
+
+    fill_sentinels(0, 0, LINK_RING_PAIRS);
+    REG(DUMP_CTRL_REG) = control;
+    REG(DUMP_BANK_SELECT_REG) = (REG(DUMP_BANK_SELECT_REG) & ~15u) | 1u;
+    memory_barrier();
+    uint32_t t0 = tick();
+    REG(DUMP_CTRL_REG) = control | DUMP_CTRL_RUN;
+    memory_barrier();
+
+    /* The write index restarts at 0; give up well before it could wrap. */
+    uint32_t limit = 2u * stop_at / pairs_per_tick;
+    bool late = false;
+    while ((REG(DUMP_WRITE_INDEX_REG) & RING_MASK) < stop_at) {
+        if (tick() - t0 > limit) {
+            late = true;
+            break;
+        }
+    }
+    REG(DUMP_CTRL_REG) = control;
+    memory_barrier();
+    wait_cycles(SWITCH_SETTLE_CYCLES_PER_PAIR_TICK / pairs_per_tick);
+    REG(DUMP_BANK_SELECT_REG) &= ~15u;
+    memory_barrier();
+    if (late)
+        return 0;
+
+    /* Samples use 20 bits, so a sentinel left in the block means a gap. */
+    const uint32_t *p = bank(0) + SNAPSHOT_FIRST;
+    for (unsigned i = 0; i < SNAPSHOT_PAIRS; i++)
+        if (p[i] == SENTINEL)
+            return 0;
+    return p;
+}
diff --git a/esp32s3/src/capture.h b/esp32s3/src/capture.h
index 00e0125..adf248c 100644
--- a/esp32s3/src/capture.h
+++ b/esp32s3/src/capture.h
@@ -12,3 +12,14 @@ unsigned capture_run(unsigned seconds);
 
 /* Statistics of the last run, indexed by ESP_STAT_*. */
 uint32_t capture_stat(unsigned index);
+
+/* Pairs in one snapshot, and where the block starts in capture bank 0. */
+#define SNAPSHOT_PAIRS 15360u
+#define SNAPSHOT_FIRST 256u
+
+/*
+ * Captures SNAPSHOT_PAIRS contiguous IQ pairs into capture bank 0 (I in
+ * bits 0..9, Q in bits 10..19 of each word) with core 1 idle. Returns the
+ * block, or 0 if the capture failed. Valid until the next capture.
+ */
+const uint32_t *capture_snapshot(void);
