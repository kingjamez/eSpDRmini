diff --git a/esp32s3/src/capture.c b/esp32s3/src/capture.c
index 209e8ae..61fa9a3 100644
--- a/esp32s3/src/capture.c
+++ b/esp32s3/src/capture.c
@@ -502,3 +502,127 @@ uint32_t capture_stat(unsigned index)
     default: return 0;
     }
 }
+
+/*
+ * Snapshots for hosts without the FPGA link: one contiguous block of IQ from
+ * 1 to 4 capture banks, with core 1 idle and the link outputs unused.
+ *
+ * The writer starts in bank 0 at ring index 0. After SNAP_UNIT new pairs in a
+ * bank, core 0 switches it to the next bank, where the ring index carries on.
+ * Afterwards each bank's data is located exactly from the sentinels left
+ * around it, and the banks must join without a gap or overlap. A 4-bank
+ * snapshot overwrites the ROM's working memory at the top of bank 3, which
+ * is restored by capture_snapshot_done() once the block has been sent.
+ */
+#define SNAP_UNIT (SNAPSHOT_FIRST + SNAPSHOT_PAIRS + 64u) /* pairs per bank before switching */
+#define SNAP_BACK 128u   /* the end search starts this far before the switch index */
+#define SNAP_SCAN 4096u  /* and gives up this far after it */
+
+static snapshot_t snap;
+static bool snap_rom_saved;
+
+/* Ring index one past the data in bank b, searching from just before the
+ * write index observed at its switch. NOT_FOUND unless data precedes it. */
+static unsigned snap_find_end(unsigned b, unsigned switched_at)
+{
+    const uint32_t *p = bank(b);
+    unsigned at = (switched_at - SNAP_BACK) & RING_MASK;
+    if (p[at] == SENTINEL)
+        return NOT_FOUND;
+    for (unsigned i = 0; i < SNAP_SCAN; i++, at = (at + 1) & RING_MASK)
+        if (p[at] == SENTINEL)
+            return at;
+    return NOT_FOUND;
+}
+
+void capture_snapshot_done(void)
+{
+    if (snap_rom_saved) {
+        copy_words((volatile uint32_t *)ROM_DATA_BASE, rom_data, ROM_DATA_BYTES / 4);
+        memory_barrier();
+        snap_rom_saved = false;
+    }
+}
+
+static const snapshot_t *snap_capture(unsigned banks)
+{
+    unsigned pairs_per_tick = radio_pairs_per_tick();
+    uint32_t control = radio_dump_control();
+    uint32_t limit = 2u * SNAP_UNIT / pairs_per_tick; /* ticks allowed per bank */
+    unsigned switched[CAPTURE_BANKS];                 /* write index at each bank's end */
+
+    if (banks == CAPTURE_BANKS) {
+        copy_words(rom_data, (volatile uint32_t *)ROM_DATA_BASE, ROM_DATA_BYTES / 4);
+        snap_rom_saved = true;
+    }
+    for (unsigned b = 0; b < banks; b++)
+        fill_sentinels(b, 0, LINK_RING_PAIRS);
+
+    REG(DUMP_CTRL_REG) = control;
+    REG(DUMP_BANK_SELECT_REG) = (REG(DUMP_BANK_SELECT_REG) & ~15u) | 1u;
+    memory_barrier();
+    REG(DUMP_CTRL_REG) = control | DUMP_CTRL_RUN;
+    memory_barrier();
+
+    bool late = false;
+    unsigned from = 0;
+    for (unsigned b = 0; b < banks && !late; b++) {
+        uint32_t t0 = tick();
+        unsigned now;
+        while ((((now = REG(DUMP_WRITE_INDEX_REG) & RING_MASK) - from) & RING_MASK) < SNAP_UNIT) {
+            if (tick() - t0 > limit) {
+                late = true;
+                break;
+            }
+        }
+        if (b + 1 < banks && !late) {
+            REG(DUMP_BANK_SELECT_REG) = (REG(DUMP_BANK_SELECT_REG) & ~15u) | (1u << (b + 1));
+            memory_barrier();
+        }
+        switched[b] = now;
+        from = now;
+    }
+    REG(DUMP_CTRL_REG) = control;
+    memory_barrier();
+    wait_cycles(SWITCH_SETTLE_CYCLES_PER_PAIR_TICK / pairs_per_tick);
+    REG(DUMP_BANK_SELECT_REG) &= ~15u;
+    memory_barrier();
+    if (late)
+        return 0;
+
+    /* Locate each bank's data and check that the banks join exactly. */
+    unsigned start = 0, skip = SNAPSHOT_FIRST, want = banks * SNAPSHOT_PAIRS;
+    snap.banks = banks;
+    snap.parts = 0;
+    snap.pairs = want;
+    for (unsigned b = 0; b < banks; b++) {
+        const uint32_t *p = bank(b);
+        if (p[start] == SENTINEL || (b && p[(start - 1) & RING_MASK] != SENTINEL))
+            return 0; /* this bank does not start where the previous one ended */
+        unsigned end = snap_find_end(b, switched[b]);
+        if (end == NOT_FOUND)
+            return 0;
+        unsigned count = (end - start) & RING_MASK;
+        if (count < SNAP_UNIT - SNAP_BACK)
+            return 0;
+        unsigned first = (start + skip) & RING_MASK, take = count - skip;
+        if (take > want)
+            take = want;
+        snap.part[snap.parts].bank = p;
+        snap.part[snap.parts].start = first;
+        snap.part[snap.parts].count = take;
+        snap.parts++;
+        want -= take;
+        skip = 0;
+        start = end;
+    }
+    return want ? 0 : &snap;
+}
+
+const snapshot_t *capture_snapshot(unsigned banks)
+{
+    const snapshot_t *s = snap_capture(banks);
+    if (!s)
+        capture_snapshot_done(); /* nothing will be sent */
+    return s;
+}
diff --git a/esp32s3/src/capture.h b/esp32s3/src/capture.h
index 00e0125..de5d3ba 100644
--- a/esp32s3/src/capture.h
+++ b/esp32s3/src/capture.h
@@ -12,3 +12,27 @@ unsigned capture_run(unsigned seconds);
 
 /* Statistics of the last run, indexed by ESP_STAT_*. */
 uint32_t capture_stat(unsigned index);
+
+/* Pairs per capture bank in a snapshot; the block skips the first
+ * SNAPSHOT_FIRST pairs the writer produces. */
+#define SNAPSHOT_PAIRS 15360u
+#define SNAPSHOT_FIRST 256u
+
+/* A captured block: `pairs` contiguous IQ pairs (I in bits 0..9, Q in bits
+ * 10..19 of each word) in up to four parts, each a run of ring indices from
+ * `start` (wrapping at LINK_RING_PAIRS) in one capture bank. */
+typedef struct {
+    unsigned banks, parts, pairs;
+    struct {
+        const uint32_t *bank;
+        unsigned start, count;
+    } part[4];
+} snapshot_t;
+
+/*
+ * Captures banks * SNAPSHOT_PAIRS contiguous IQ pairs (banks 1..4) with core 1
+ * idle. Returns the block, or 0 if the capture failed. Valid until the next
+ * capture; call capture_snapshot_done() once it has been sent.
+ */
+const snapshot_t *capture_snapshot(unsigned banks);
+void capture_snapshot_done(void);
