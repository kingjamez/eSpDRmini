         uint8_t status = execute(op, (uint32_t)arg_high << 16 | arg, &value);
         arg_high = op == ESP_ARG_HIGH ? arg : 0;
         reply(op, status, sequence, value);
+        if (snapshot)
+            send_snapshot();
         last_command = cpu_cycles();
     }
 }
