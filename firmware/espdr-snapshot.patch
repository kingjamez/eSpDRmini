 }
 
 static uint32_t load_le(const uint8_t *p, unsigned bytes)
@@ -196,6 +202,14 @@ static uint8_t execute(uint8_t op, uint32_t arg, uint32_t *value)
             return CTL_NOT_READY;
         *value = capture_run(arg);
         return *value ? CTL_RUN_FAILED : CTL_OK;
+    case ESP_SNAPSHOT:
+        if (radio_stat(ESP_STAT_RADIO) != ESP_RADIO_OK)
+            return CTL_NOT_READY;
+        snapshot = capture_snapshot();
+        if (!snapshot)
+            return CTL_RUN_FAILED;
+        *value = SNAPSHOT_PAIRS;
+        return CTL_OK;
     case ESP_STOP: /* the run, if any, has already ended */
     case ESP_ARG_HIGH: /* kept by the command loop */
         return CTL_OK;
@@ -204,6 +218,36 @@ static uint8_t execute(uint8_t op, uint32_t arg, uint32_t *value)
     }
 }
 
+/* Sends the captured block after its response, 20 bits per pair. */
+static void send_snapshot(void)
+{
+    uint8_t header[12] = {'S', 'N', 'A', 'P'};
+    store_le(header + 4, SNAPSHOT_PAIRS, 4);
+    store_le(header + 8, SNAPSHOT_FIRST, 4);
+    serial_write(header, sizeof(header));
+    uint32_t crc = crc32_update(0xFFFFFFFFu, header, sizeof(header));
+
+    uint8_t chunk[320]; /* 128 pairs, five 64-byte USB packets */
+    unsigned used = 0;
+    for (unsigned i = 0; i < SNAPSHOT_PAIRS; i += 2) {
+        uint32_t a = snapshot[i] & 0xFFFFFu, b = snapshot[i + 1] & 0xFFFFFu;
+        chunk[used++] = (uint8_t)a;
+        chunk[used++] = (uint8_t)(a >> 8);
+        chunk[used++] = (uint8_t)(a >> 16 | b << 4);
+        chunk[used++] = (uint8_t)(b >> 4);
+        chunk[used++] = (uint8_t)(b >> 12);
+        if (used == sizeof(chunk)) {
+            serial_write(chunk, used);
+            crc = crc32_update(crc, chunk, used);
+            used = 0;
+        }
+    }
+    uint8_t trailer[4];
+    store_le(trailer, ~crc, 4);
+    serial_write(trailer, sizeof(trailer));
+    snapshot = 0;
+}
