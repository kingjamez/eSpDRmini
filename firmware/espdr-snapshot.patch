 }
 
 static uint32_t load_le(const uint8_t *p, unsigned bytes)
@@ -196,6 +203,16 @@ static uint8_t execute(uint8_t op, uint32_t arg, uint32_t *value)
             return CTL_NOT_READY;
         *value = capture_run(arg);
         return *value ? CTL_RUN_FAILED : CTL_OK;
+    case ESP_SNAPSHOT:
+        if (radio_stat(ESP_STAT_RADIO) != ESP_RADIO_OK)
+            return CTL_NOT_READY;
+        if (arg > CAPTURE_BANKS)
+            return CTL_BAD_ARGUMENT;
+        snapshot = capture_snapshot(arg ? arg : 1);
+        if (!snapshot)
+            return CTL_RUN_FAILED;
+        *value = snapshot->pairs;
+        return CTL_OK;
     case ESP_STOP: /* the run, if any, has already ended */
     case ESP_ARG_HIGH: /* kept by the command loop */
         return CTL_OK;
@@ -204,6 +221,50 @@ static uint8_t execute(uint8_t op, uint32_t arg, uint32_t *value)
     }
 }
 
+/* Sends the captured block after its response, 20 bits per pair, then
+ * releases the capture memory. */
+static void send_snapshot(void)
+{
+    uint8_t header[12] = {'S', 'N', 'A', 'P'};
+    store_le(header + 4, snapshot->pairs, 4);
+    store_le(header + 8, SNAPSHOT_FIRST, 4);
+    serial_write(header, sizeof(header));
+    uint32_t crc = crc32_update(0xFFFFFFFFu, header, sizeof(header));
+
+    uint8_t chunk[320]; /* 128 pairs, five 64-byte USB packets */
+    unsigned used = 0;
+    uint32_t held = 0; /* first pair of the next two, which may span parts */
+    bool holding = false;
+    for (unsigned k = 0; k < snapshot->parts; k++) {
+        const uint32_t *p = snapshot->part[k].bank;
+        for (unsigned i = 0, at = snapshot->part[k].start; i < snapshot->part[k].count;
+             i++, at = (at + 1) & (LINK_RING_PAIRS - 1)) {
+            uint32_t b = p[at] & 0xFFFFFu;
+            if (!holding) {
+                held = b;
+                holding = true;
+                continue;
+            }
+            holding = false;
+            chunk[used++] = (uint8_t)held;
+            chunk[used++] = (uint8_t)(held >> 8);
+            chunk[used++] = (uint8_t)(held >> 16 | b << 4);
+            chunk[used++] = (uint8_t)(b >> 4);
+            chunk[used++] = (uint8_t)(b >> 12);
+            if (used == sizeof(chunk)) {
+                serial_write(chunk, used);
+                crc = crc32_update(crc, chunk, used);
+                used = 0;
+            }
+        }
+    }
+    uint8_t trailer[4];
+    store_le(trailer, ~crc, 4);
+    serial_write(trailer, sizeof(trailer));
+    snapshot = 0;
+    capture_snapshot_done();
+}
